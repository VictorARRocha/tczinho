:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy host.docker.internal:8001 {
			# A API pode ficar alguns segundos sem atender (rebuild, pico de pedidos): tenta de novo antes de devolver 502.
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	@internal_api {
		path /health /auth /auth/* /modules /modules/* /runs /runs/* /failures/* /testcase-hierarchy /rerun-requests /rerun-requests/* /bridge/* /analyze /ingest /files/*
	}

	handle @internal_api {
		reverse_proxy host.docker.internal:8001 {
			# A API pode ficar alguns segundos sem atender (rebuild, pico de pedidos): tenta de novo antes de devolver 502.
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-X-Powered-By
		-Server
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log
}
