FROM node:22-alpine AS dashboard-build

WORKDIR /app

ARG VITE_DATA_PROVIDER=api
ARG VITE_AGENT_TC_API_URL=/api
ENV VITE_DATA_PROVIDER=${VITE_DATA_PROVIDER}
ENV VITE_AGENT_TC_API_URL=${VITE_AGENT_TC_API_URL}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:2-alpine

COPY deploy/d01/Caddyfile /etc/caddy/Caddyfile
COPY --from=dashboard-build /app/dist /srv
